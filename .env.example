# ==============================================================================
# Pramaan (VeriCampus) — Environment Configuration Template (.env.example)
# Copy to `.env` for local overrides or container deployments.
# ==============================================================================

# --- Core Server & Cryptographic Signing ---
PRAMAAN_APP_NAME="Pramaan"
PRAMAAN_PORT=8000
# Default true keeps runs air-gapped; set false to allow first-run HF Hub cache download into HF_HOME
PRAMAAN_OFFLINE_ONLY=true
PRAMAAN_MAX_PDF_PAGES=100
# Leave unset in local dev to auto-generate and persist a 256-bit secret key in uploads/.pramaan_secret_key
# Set an explicit 64-hex-character secret in production:
PRAMAAN_SECRET_KEY=
# Optional explicit key ID and comma-separated retired secrets (`secret` or `kid:secret`) for key rotation:
PRAMAAN_SIGNING_KEY_ID=
PRAMAAN_PREVIOUS_SECRET_KEYS=
PRAMAAN_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Multi-Tenant Database (SQLite WAL default | PostgreSQL 16+ asyncpg with RLS) ---
# Default local SQLite WAL:
PRAMAAN_DATABASE_URL=sqlite+aiosqlite:///./pramaan.db
# When running with `docker compose --profile postgres up`, connect as the RLS-enforced role:
# PRAMAAN_DATABASE_URL=postgresql+asyncpg://pramaan_app:pramaan_app_pw@db:5432/pramaan
PRAMAAN_DEFAULT_TENANT_ID=default

POSTGRES_USER=pramaan
POSTGRES_PASSWORD=pramaan_dev_pw
POSTGRES_DB=pramaan
POSTGRES_PORT=5432

# --- DigiLocker Verified Parental Consent (DPDP Act 2023 §9 & Rule 10 OAuth 2.0 + PKCE) ---
# When PRAMAAN_DIGILOCKER_CLIENT_ID is empty, Pramaan runs RFC 7636 S256 PKCE in local sandbox mode.
PRAMAAN_DIGILOCKER_CLIENT_ID=
PRAMAAN_DIGILOCKER_CLIENT_SECRET=
PRAMAAN_DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/portals/consents/digilocker-callback

# --- Optional Outbound PII-Scrubbed LLM Rewriter ---
# Only PII-masked text ([STUDENT_PRN_1], [AADHAAR_1], etc.) is sent when a key is configured.
# When all keys are empty, Pramaan uses deterministic local AST rewriting.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PRAMAAN_LLM_API_KEY=
PRAMAAN_LLM_MODEL=gemini-2.5-flash
